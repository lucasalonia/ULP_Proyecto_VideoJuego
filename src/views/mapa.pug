extends layouts/mainLayout.pug

block head
  style.
    @font-face {
      font-family: "miFuente";
      src: url("/fonts/GamePocket-Regular.ttf") format("truetype");
    }

    html,
    body {
      margin: 0;
      padding: 0;
    /*  height: 100%;*/
      overflow: hidden;
      background: #ccfaff !important;
    }

    .app-main {
      height: calc(100dvh - var(--nav-h, 72px));
      min-height: calc(100dvh - var(--nav-h, 72px));
      overflow: hidden;
    }

    #phaser-container {
      width: 100%;
      height: calc(100vh - var(--nav-h, 72px));
      min-height: calc(100dvh - var(--nav-h, 72px));
      position: relative;
      overflow: hidden;
      background-image: url("/img/degradeNaranja1.png");
      background-size: cover; 
      background-position: center;
      image-rendering: pixelated; /* Para que no s
      background-repeat: no-repeat; /* Que no se repita como mosaico */
     
    }

    #phaser-container canvas {
      display: block;
      margin: 0 auto;
      margin-top: 20px;
    }

block content
  #phaser-container
  script(src='/phaser.min.js')
  script(src='/js/scriptMapa.js')