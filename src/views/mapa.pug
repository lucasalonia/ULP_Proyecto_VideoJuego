extends layouts/mainLayout.pug

block content
  head
    title Mapa del Juego
    style.
      body {
        background: black;
        overflow: hidden;
        margin: 0;
        padding: 0;
      }

      canvas {
        display: block;
        margin: 0 auto;
        position: relative;
        top: 0;
        transform: none; /* eliminamos el centrado absoluto */
      }

      #phaser-container {
        position: relative;
       /* altura del menú del layout */
        width: 100%;
        height: 100% /* ocupa el resto del alto visible */
      }

  #phaser-container
  script(src='../../phaser.min.js')
  script(src='/js/scriptMapa.js')
