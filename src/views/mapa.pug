extends layouts/mainLayout.pug

block head
  style.
    @font-face {
      font-family: "miFuente";
      src: url("/fonts/GamePocket-Regular.ttf") format("truetype");
    }

    html {
     background: #95c2f0 !important;

    }

    body {
      overflow: hidden;
      margin: 0;
      padding: 0;
      background: transparent !important;
    }

    canvas {
      display: block;
      margin: 0 auto;
      position: relative;
      top: 0;
      transform: none;
    }

    #phaser-container {
      position: relative;
      width: 100%;
      height: 100%;
    }

block content
  #phaser-container
  script(src='../../phaser.min.js')
  script(src='/js/scriptMapa.js')
