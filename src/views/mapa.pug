extends layouts/mainLayout.pug

block head
  style.
    @font-face {
      font-family: "miFuente";
      src: url("/fonts/GamePocket-Regular.ttf") format("truetype");
    }

    html {
     background: #98EAEA !important;

    }

    body {
      overflow: hidden;
      margin: 0;
      padding: 0;
     background-image:url("/img/degradeNaranja1.PNG"); ;
    }

    canvas {
      display: block;
      margin: 0 auto;
      margin-top: 20px;
      position: relative;
      top: 0;
      transform: none;
    }

    #phaser-container {
      position: relative;
      width: 100%;
      height: 100%;
    }

block content
  #phaser-container
  script(src='../../phaser.min.js')
  script(src='/js/scriptMapa.js')
