doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Pagina no encontrada
    link(href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet")
    link(rel="icon" type="image/png" href="/img/escudo-de-san-luis.png")
    style.
      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background-color: #e7d58a;
        background-image: radial-gradient(#72d8e6 18%, transparent 19%);
        background-size: 18px 18px;
        font-family: "Press Start 2P", monospace;
        box-sizing: border-box;
      }

      *,
      *::before,
      *::after {
        box-sizing: inherit;
      }

      .not-found-card {
        width: min(760px, 100%);
        padding: 28px 24px 30px;
        background: #4f4f4f;
        border: 5px solid #7deaff;
        box-shadow: 8px 8px 0 #1b1b1b;
        text-align: center;
        color: #ffffff;
      }

      .not-found-label {
        display: inline-block;
        margin-bottom: 22px;
        padding: 14px 24px;
        background: #f2b08c;
        border: 5px solid #4a433f;
        color: #333333;
        font-size: clamp(22px, 3vw, 36px);
        line-height: 1.2;
        box-shadow: 6px 6px 0 rgba(74, 67, 63, 0.95);
      }

      .not-found-title {
        margin: 0 0 18px;
        font-size: clamp(20px, 2.4vw, 34px);
        line-height: 1.4;
        color: #7deaff;
      }

      .not-found-text {
        max-width: 620px;
        margin: 0 auto 28px;
        font-size: clamp(13px, 1.45vw, 17px);
        line-height: 1.9;
        color: #f7fbff;
      }

      .not-found-actions {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
      }

      .not-found-btn {
        min-width: 220px;
        padding: 16px 20px;
        border: 4px solid #007bb8;
        background: #ffffff;
        color: #007bb8;
        text-decoration: none;
        font-size: 13px;
        line-height: 1.4;
        box-shadow: 0 4px 0 #004d70;
        transition: transform 0.1s ease, box-shadow 0.1s ease;
      }

      .not-found-btn:hover {
        transform: translate(-2px, -2px);
        box-shadow: 0 6px 0 #004d70;
      }

      .not-found-btn:active {
        transform: translate(2px, 2px);
        box-shadow: 0 2px 0 #004d70;
      }

      @media (max-width: 768px) {
        body {
          padding: 16px;
        }

        .not-found-card {
          padding: 22px 16px 24px;
          box-shadow: 6px 6px 0 #1b1b1b;
        }

        .not-found-label {
          margin-bottom: 18px;
          padding: 12px 16px;
          border-width: 4px;
          box-shadow: 4px 4px 0 rgba(74, 67, 63, 0.95);
        }

        .not-found-btn {
          min-width: 100%;
          font-size: 12px;
        }
      }
  body
    section.not-found-card
      span.not-found-label 404
      h1.not-found-title Pagina no encontrada
      p.not-found-text
        | La ruta que buscaste no existe o ya no esta disponible.
        br
        | Podes volver al inicio o seguir explorando el juego desde el mapa.
      .not-found-actions
        a.not-found-btn(href='/') Volver al inicio
        a.not-found-btn(href='/mapa') Ir al mapa
        a.not-found-btn(href='/departamentos') Ver departamentos
