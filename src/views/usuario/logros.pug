extends ../layouts/mainLayout.pug

block content
  // CONTENEDOR PRINCIPAL CON FONDO PROPIO
  .contenedor-principal.logros-page

    // ===================== LOGROS POR DEPARTAMENTO =====================
    .logro-paraje
      h3 Parajes Completados por Departamento

      -
        let nombreArchivo = "desconocido";

        if (actual && actual.nombre) {
          nombreArchivo = actual.nombre
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "") // quitar tildes
            .replace(/\s+/g, "");           // quitar espacios
        }

      .departamento
        if actual
          .titulo #{actual.nombre}
        else
          .titulo Departamento desconocido

        .icono-insignia
          if insigniaCompletada
            img(
              src=`/img/insignias/${nombreArchivo}.png`
              alt=`Insignia ${actual ? actual.nombre : ""}`
            )
            span.logro-completado
              span Departamento
              span Completado
          else
            img(
              src=`/img/insignias/${nombreArchivo}_blancoynegro.png`
              alt=`Insignia ${actual ? actual.nombre : ""}`
            )

        .lista-parajes
          if parajes && parajes.length
            each p in parajes
              .paraje-item
                .icono-trofeo
                  img(src="/img/trofeo1.png")
                .nombre-paraje= p
          else
            .paraje-item
              .nombre-paraje No hay logros.

        -
          let indexActual = 0;
          if (departamentos && actual) {
            indexActual = departamentos.findIndex(
              d => d.departamento_id === actual.departamento_id
            );
            if (indexActual < 0) indexActual = 0;
          }

          let siguiente = null;
          if (departamentos && departamentos.length) {
            siguiente = departamentos[(indexActual + 1) % departamentos.length];
          }

          const idSiguiente = siguiente ? siguiente.departamento_id : 0;

        .flecha
          a(href=`/logros/${idSiguiente}`)
            img(src="/img/flechaRoja.png", alt="Ir")

    // ===================== LOGROS DE TIEMPO =====================
    .logro-tiempo
      h3 Tiempos del Mapa

      .mejores-tiempos
        if tiempos && tiempos.length
          each tiempo in tiempos
            .tiempo-item
              span= tiempo.tiempoFormateado
        else
          .tiempo-item
            span No hay tiempos registrados.
