extends ../layouts/mainLayout.pug

block content
  if user && user.userId > 0
    //- Contenedor principal
    .contenedor-principal.logros-page

      //- SECCIÓN DE PARAJES (Bloque 1)
      .logro-paraje
        h3 Parajes Completados por Departamento
        
        //- Lógica de JS (asegúrate de que el guión esté bien alineado)
        -
          let indexActual = 0;
          if (departamentos && actual) {
            indexActual = departamentos.findIndex(d => d.departamento_id === actual.departamento_id);
            if (indexActual < 0) indexActual = 0;
          }
          let siguiente = (departamentos && departamentos.length) ? departamentos[(indexActual + 1) % departamentos.length] : null;
          const idSiguiente = siguiente ? siguiente.departamento_id : 0;

        .departamento
          if actual
            .titulo #{actual.nombre}
          else
            .titulo Departamento desconocido

          .icono-insignia
            if actual
              if insigniaCompletada
                img(src=`/img/insignias/${actual.nombre}.png`)
                span.logro-completado
                  span Departamento
                  span Completado
              else
                img(src=`/img/insignias/${actual.nombre}_blancoynegro.png`)
            else
              img(src="/img/insignias/insigniaGris.png")

          .lista-parajes
            if parajes && parajes.length
              each p in parajes
                .paraje-item
                  .icono-trofeo: img(src="/img/trofeo1.png")
                  .nombre-paraje= p
            else
              .paraje-item: .nombre-paraje No hay logros.

          if idSiguiente && idSiguiente > 0
            .flecha
              a(href=`/logros/${idSiguiente}`)
                img(src="/img/flechaRoja.png", alt="Ir")

      //- SECCIÓN DE TIEMPOS (Bloque 2)
      //- IMPORTANTE: Esta línea debe estar alineada con .logro-paraje
      .logro-tiempo
        h3 Tiempos del Mapa
        .mejores-tiempos
          if tiempos && tiempos.length
            each tiempo in tiempos
              .tiempo-item
                span= tiempo.tiempoFormateado
          else
            .tiempo-item
              span No hay tiempos registrados.

  else
    .container.py-5.text-center
      .aviso-invitado
        h1.aviso-titulo No tenés una cuenta personal todavía

        p.aviso-texto
          | Para guardar tu progreso, desbloquear logros y personalizar tu cuenta,
          br
          | podés crear una cuenta gratuita cuando quieras.

        .mt-4
          a.btn.btn-primary(href="/register") Crear Cuenta
          a.btn.btn-secondary.ms-3(href="/") Volver al Inicio
