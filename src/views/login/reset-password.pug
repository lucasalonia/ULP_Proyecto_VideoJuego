html
  head
    link(rel="stylesheet", href="/css/login.css")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet")
    title Restablecer Contraseña - ULP Juego
  body.body
    main.auth-container
      section.auth-box
        div.presentacion
          img.presentacion-logo(src="/img/logos/ulp_logo.png" alt="Logo ULP")
          h1.presentacion-titulo COMARCAS DE SAN LUIS
          p.presetacion-subtitulo Juego educativo del area de Pensamiento Lógico
        
        h1.auth-title Nueva contraseña
        
        // El action debe ser una ruta POST que reciba la nueva contraseña y el token
        form.auth-form#resetPasswordForm(action="/reset-password" method="POST") 
          
          // Campo oculto para enviar el token que recibiste por URL
          input(type="hidden" name="token" value=token) 
          
          // Campos para la nueva contraseña
          input.auth-input(type="password" name="password" placeholder="Nueva Contraseña" required)
          input.auth-input(type="password" name="password_confirm" placeholder="Confirmar Contraseña" required)
          
          button.auth-btn(type="submit") Cambiar Contraseña
          
        div.auth-links
          a(href="/login") Volver al inicio
          
    #loadingSpinner.position-fixed.top-0.start-0.w-100.h-100.d-flex.justify-content-center.align-items-center.bg-dark.bg-opacity-50.d-none(style="z-index: 9999;")
            .spinner-border.text-light(role="status" style="width: 3rem; height: 3rem;")
                span.visually-hidden Loading...
    script(src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js")
    script(src='/js/resetPassword.js') 