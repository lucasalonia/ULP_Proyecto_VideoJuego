html 
  head 
    link(rel="stylesheet", href="/css/login.css")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet")
    link(rel="icon" type="image/png" href="/img/EscudoDeSanLuis.png")
  body.body
    main.auth-container
      section.auth-box
        div.presentacion
          img.presentacion-logo(src="/img/logos/ulp_logo.png" alt="Logo ULP")
          h1.presentacion-titulo COMARCAS DE SAN LUIS
          p.presetacion-subtitulo Juego educativo del area de Pensamiento Lógico
        h1.auth-title Jugar como invitado
        form.auth-form(action="/guest" method="POST")
          input.auth-input(type="text" name="nickname" placeholder="Elige un nickname" required)
          button.auth-btn(type="submit") Entrar al juego
        div.auth-links
          a(href="/login") Iniciar sesión
          a(href="/register") Crear cuenta

    #loadingSpinnerLog.position-fixed.top-0.start-0.w-100.h-100.d-flex.justify-content-center.align-items-center.bg-dark.bg-opacity-50.d-none(style="z-index: 9999;")
            .spinner-border.text-secondary(role="status" style="width: 3rem; height: 3rem;")
                span.visually-hidden Loading...
                
    script(src="/js/invitado.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js")
