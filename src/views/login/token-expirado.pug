html
  head
    link(rel="stylesheet", href="/css/login.css")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet")
    title Token Expirado - ULP Juego
  body.body
    main.auth-container
      section.auth-box
        div.presentacion
          img.presentacion-logo(src="/img/logos/ulp_logo.png" alt="Logo ULP")
          h1.presentacion-titulo COMARCAS DE SAN LUIS
          p.presetacion-subtitulo Juego educativo del area de Pensamiento Lógico
        
        // Título de Error
        h1.auth-title(style="color: #cc0000; margin-left: 30px") ¡Enlace Inválido o Expirado!
        
        div.auth-form(style="text-align: center; margin-bottom: 20px; padding: 0 30px;")
          // Mensaje de Error
          p(style="font-size: 1.1rem; color: #555555; margin-bottom: 25px;")
            | El enlace de restablecimiento de contraseña que utilizaste ya expiró o es inválido.
            | Los enlaces de seguridad solo son válidos por 10 minutos.
          
          // Botón para iniciar el proceso de nuevo
          a.auth-btn(href="/recover" style="display: inline-block; width: auto;")
            | Volver a Solicitar Enlace
            
        div.auth-links
          a(href="/login") Ir al Inicio de Sesión
          
    // SCRIPTS NECESARIOS
    script(src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js")
    // Aquí puedes incluir un script opcional para mostrar un Toastr si fuera necesario