
header 
  nav.navbar
    div.logo
      a(href='/') 🎮 ULP Game
    ul.nav-links
      li: a(href='/login') Login
      li: a(href='/mapa') Mapa
      li: a(href='/departamentos') Departamentos
      li: a(href='/contacto') Contacto
      li.nav-item.dropdown

        a#userDropdown.nav-link.dropdown-toggle.d-flex.align-items-center(href='#' role='button' data-bs-toggle='dropdown' aria-expanded='false')
          img.rounded-circle(src=user.fotoUrl alt='Foto de Perfil' style='width: 30px; height: 30px; object-fit: cover; margin-right: 8px;')
          | #{user.userName}
        ul.dropdown-menu.dropdown-menu-end.shadow-sm(aria-labelledby='userDropdown')
          li
            a.dropdown-item.d-flex.align-items-center(href='/perfil')
              i.bi.bi-person-badge.me-2 
              | Ver mi Perfil
          li
            hr.dropdown-divider
            
          li
            a#logout-link.dropdown-item.text-danger.d-flex.align-items-center(href='#') 
              i.bi.bi-box-arrow-right.me-2
              | Cerrar Sesión

  script(src='/js/logout.js')
  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
