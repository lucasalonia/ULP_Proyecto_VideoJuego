header
  nav.navbar.navbar-expand-lg.navbar-dark(style="background:#111; border-bottom: 3px solid #00eaff;")
    .container-fluid

      // LOGO IZQUIERDA
      a.navbar-brand.d-flex.align-items-center(href='/')
        | 🎮 ULP Comarcas San Luis

      // BOTÓN HAMBURGUESA
      button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation")
        span.navbar-toggler-icon

      // CONTENIDO COLAPSABLE (DERECHA)
      #navbarSupportedContent.collapse.navbar-collapse
        ul.navbar-nav.me-auto.mb-2.mb-lg-0
          li.nav-item
            a.nav-link(href='/') Inicio
          li.nav-item
            a.nav-link(href='/mapa') Mapa
          li.nav-item
            a.nav-link(href='/departamentos') Departamentos
          li.nav-item
            a.nav-link(href='/contacto') Contacto
          if !user.isAuthenticated
            li.nav-item
              a.nav-link(href='/login') Login

        // PERFIL (DERECHA)
        ul.navbar-nav.ms-auto
          li.nav-item.dropdown
            a#userDropdown.nav-link.dropdown-toggle.d-flex.align-items-center(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false")
              img.rounded-circle(src=user.fotoUrl alt="Foto" style="width:30px; height:30px; object-fit:cover; margin-right:8px;")
              | #{user.userName}

            ul.dropdown-menu.dropdown-menu-end.shadow-sm(aria-labelledby="userDropdown")
              li
                a.dropdown-item.d-flex.align-items-center(href="/perfil")
                  i.bi.bi-person-badge.me-2
                  | Ver mi Perfil
              li
                hr.dropdown-divider
              li
                a#logout-link.dropdown-item.text-danger.d-flex.align-items-center(href="#")
                  i.bi.bi-box-arrow-right.me-2
                  | Cerrar Sesión

  script(src="/js/logout.js")
