header
  nav.navbar.navbar-expand-lg.navbar-dark
    .container-fluid

      a.navbar-brand.d-flex.align-items-center(href='/')
        img(
          src="/img/EscudoDeSanLuis.png"
          alt="ULP Comarcas San Luis"
          style="height:40px; width:auto; margin-right:10px;"
        )
        span ULP Comarcas San Luis
      #navbarSupportedContent.collapse.navbar-collapse

        // ===== LINKS IZQUIERDA =====
        ul.navbar-nav.ms-auto.mb-2.mb-lg-0
          li.nav-item
            a.nav-link(href='/') Inicio
          li.nav-item
            a.nav-link(href='/mapa') Mapa
          li.nav-item
            a.nav-link(href='/departamentos') Departamentos
          li.nav-item
            a.nav-link(href='/nosotros') Nosotros

        // ===== PERFIL DERECHA =====
        ul.navbar-nav.ms-3
          li.nav-item.dropdown
            a#userDropdown.nav-link.dropdown-toggle.d-flex.align-items-center(
              href="#"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            )
              img.rounded-circle(
                src=user.fotoUrl
                alt="Foto"
                style="width:30px; height:30px; object-fit:cover; margin-right:8px;"
              )
              | #{user.userName}

            ul.dropdown-menu.dropdown-menu-end.shadow-sm(aria-labelledby="userDropdown")
              li
                a.dropdown-item(href='/perfil') Perfil
              li
                hr.dropdown-divider
              li
                a.dropdown-item.text-danger(href="/logout") Cerrar sesión
