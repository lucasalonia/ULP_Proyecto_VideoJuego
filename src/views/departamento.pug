extends layouts/mainLayout.pug

block content
  main.escena(
    style=`--color-principal:${departamento.colorBorde};
          --img-carta:url(/img/tarjetas/${departamento.imagen_carta});
          --img-fondo:url(/img/bg/${departamento.imagen_fondo});`
  )

    header.barra-superior
      h1.titulo COMARCAS DE SAN LUIS
      span.contador-departamentos #{numeroParaje} / #{totalParajes}
      br
      span#cronometro.cronometro 00:00.00

    // Casilleros superiores
    .casilleros
      each s, i in tokens
        if s === '|'
          div.casillero.casillero-espacio
        else
          button.casillero(type="button" data-indice=i)
    // === TOAST DE VICTORIA ===
      .toast-wrapper
    div.toast.toast--oculto
      span.toast-msg
      .toast-botones
        if urlSiguiente
          a.btn-siguiente(href=urlSiguiente) Siguiente
        if urlVolver
          a.btn-volver(href=urlVolver) Volver

    // Carta y fichas
    section.carta
      .carta__interior
        .fichas
          each s, idx in silabas
            button.ficha(type="button" data-silaba=s data-indice=idx)= s
        .carta__etiqueta= departamento.nombre

    

  // JSON hacia JS
  script.
    window.JUEGO_DATA = {
        ordenCorrecto: !{JSON.stringify(ordenCorrecto)},
        urlSiguiente: "#{urlSiguiente}",
        urlVolver: "#{urlVolver}",
        nombreParaje: "#{paraje.nombre}",
        usuarioId: "#{usuarioId}",
        parajeId: "#{paraje.id}"
      };



  script(src="/js/departamento.js")
