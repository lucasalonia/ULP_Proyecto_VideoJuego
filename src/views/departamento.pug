extends layouts/mainLayout.pug

block content
  main.escena(
    style=`--color-principal:${departamento.colorBorde};
          --img-carta:url(/img/tarjetas/${departamento.imagen_carta});
          --img-fondo:url(/img/fondos/${departamento.imagen_fondo});`
  )

    // ====== BOTÓN REGLAS ======
    .top-actions
      button#btnReglas.btn-ui(type="button") Reglas del juego

    // ====== MODAL REGLAS ======
    .modal-overlay#modalReglas(aria-hidden="true")
      .modal-card(role="dialog" aria-modal="true" aria-labelledby="modalReglasTitle")
        .modal-header
          h2#modalReglasTitle.modal-title Reglas del juego
          button#btnCerrarReglas.modal-close(type="button" aria-label="Cerrar") ✕

        .modal-body
          p Elegí un departamento y armá el nombre del paraje usando sílabas.
          ul
            li Seleccioná una sílaba y colócala en el lugar correcto.
            li Podés cambiar las sílabas las veces que quieras.
            li Completá todos los parajes del departamento para ganar.
            li Cuando vuelvas al juego, tu progreso se guarda.

    .juego-layout

      // ==========================
      // CARTA IZQUIERDA
      // ==========================
      section.carta
        .carta__interior
          .fichas
            each s, idx in silabas
              button.ficha(
                type="button"
                data-silaba=s
                data-indice=idx
              )= s

          .carta__etiqueta= departamento.nombre

      // ==========================
      // PANEL DERECHA
      // ==========================
      .juego-panel

        header.barra-superior
          h1.titulo COMARCAS DE SAN LUIS

          .barra-metas
            span.contador-departamentos #{numeroParaje} / #{totalParajes}

            .cronometro-linea
              span#cronometro.cronometro 00:00.00
              button#btnPausa.btn-ui(type="button" aria-pressed="false") Pausa

        // ===== CASILLEROS =====
        .casilleros-area
          .casilleros
            each s, i in tokens
              if s === '|'
                div.casillero.casillero-espacio
                br
              else
                button.casillero(
                  type="button"
                  data-indice=i
                )

        // ===== TOAST DE VICTORIA =====
        .toast-wrapper
          .comarca-toast.comarca-toast--oculto
            span.comarca-toast-msg

            .comarca-toast-botones
              if urlSiguiente
                a.btn-ui(href=urlSiguiente) Siguiente
              if urlVolver
                a.btn-ui(href=urlVolver) Volver

  script.
    window.JUEGO_DATA = !{JSON.stringify(juegoData)};

  script(src="/js/departamento.js")