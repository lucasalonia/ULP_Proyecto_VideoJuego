extends layouts/mainLayout.pug

block content
  main.escena(
    style=`--color-principal:${departamento.colorBorde || '#007bb8'};
            --img-carta:url(/img/tarjetas/${departamento.imagen_carta});
            --img-fondo:url(/img/bg/${departamento.imagen_fondo || 'default-bg.jpg'});`
  )
    // Título del juego
    header.barra-superior
      h1.titulo COMARCAS DE SAN LUIS

    // Casilleros superiores (espacios a completar)
    .casilleros
      each s, i in tokens
        if s === '|'
          div.casillero.casillero-espacio
        else
          button.casillero(type="button" data-indice=i)

    // Carta con fondo del departamento
    section.carta
      .carta__interior
        .fichas
          each s, idx in silabas
            button.ficha(type="button" data-silaba=s data-indice=idx)= s
        .carta__etiqueta= departamento.nombre

  // Datos del juego
  script.
    window.JUEGO_DATA = { ordenCorrecto: !{JSON.stringify(ordenCorrecto)} };
  script(src="/js/departamento.js")
