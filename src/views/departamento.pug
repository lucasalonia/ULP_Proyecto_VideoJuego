extends layouts/mainLayout.pug

block content
  main.scene(
    style=`--primary:${departamento.colorBorde || '#007bb8'};
            --card-img:url(/img/tarjetas/${departamento.imagen_carta});
            --bg-img:url(/img/bg/${departamento.imagen_fondo || 'default-bg.jpg'});`
  )
    // Título del juego
    header.topbar
      h1.title COMARCAS DE SAN LUIS

    // Slots superiores (espacios a completar)
    .slots
      each s, i in tokens
        if s === '|'
          div.slot.space
        else 
          button.slot(type="button" data-index=i)

    // Carta con fondo del departamento
    section.card
      .card-inner
        .chips
          each s, idx in silabas
            button.silaba(type="button" data-silaba=s data-id=idx)= s
        .card-badge= departamento.nombre

  // Datos del juego
  script.
    window.JUEGO_DATA = { ordenCorrecto: !{JSON.stringify(ordenCorrecto)} };
  script(src="/js/departamento.js")
